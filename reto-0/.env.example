# Plantilla de variables de entorno. Copia este archivo a .env y ajusta los valores.

# Clave secreta de Flask. Genera una con:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambia-esta-clave-por-una-segura

# URI de la base de datos (por defecto SQLite local en instance/)
DATABASE_URL=sqlite:///tasks.db

# Modo debug: 1 activado, 0 desactivado
FLASK_DEBUG=0
